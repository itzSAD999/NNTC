# =============================================================================
# NMTC Platform — environment variables
# Copy to .env.local (local) or set in Vercel → Environment Variables (production).
# =============================================================================

# --- Supabase (required for live data, auth, contact form, requests) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (use production domain on Vercel) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend — required for notifications) ---
# Verify sending domain in Resend before production use.
RESEND_API_KEY=
EMAIL_FROM="NMTC <no-reply@nmtc.edu.gh>"
CONTACT_INBOX_EMAIL=
# Optional fallback if CONTACT_INBOX_EMAIL unset (settings.email_main also used)
EMAIL_MAIN=
